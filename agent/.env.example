# Agent 007 Environment Configuration
# Copy this file to .env and fill in your values

# Network Configuration
NETWORK=mainnet-beta
RPC_ENDPOINT=https://api.mainnet-beta.solana.com

# Wallet Addresses (REQUIRED)
EARNING_WALLET=your_wallet_address_here
TOKEN_ADDRESS=your_007_token_mint_address_here
BURN_ADDRESS=11111111111111111111111111111111
PAYMENT_AUTHORITY=pump_fun_payment_authority_address

# Protocol Parameters
MIN_BUYBACK_THRESHOLD=0.1
CHECK_INTERVAL_SECONDS=300
MAX_BUYBACK_AMOUNT=10.0
SLIPPAGE_BPS=100

# pump.fun Tokenized Agent Settings
BUYBACK_RATE_BPS=5000
# Buyback rate in basis points (5000 = 50% of revenue goes to buybacks)
# Set by payment authority, can be adjusted later

# DEX Configuration
DEX_PROGRAM_ID=JUP4Fb2cqiRUcaTHdrPC8h2gNsA2ETXiPDD33WcGuJB

# Safety Settings
ENABLE_SAFETY_CHECKS=true

# Logging
LOG_LEVEL=INFO
LOG_FILE=agent_007.log
